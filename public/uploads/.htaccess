# Block execution of PHP and other script files in upload directories
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|pht|phar|cgi|pl|asp|aspx|jsp|py|sh)$">
    Require all denied
</FilesMatch>

# Disable script execution via mod_php / PHP-FPM
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Prevent directory browsing
Options -Indexes
